# ==============================================================================
# DataPilot - Environment Configuration
# ==============================================================================

# Backend Core Settings
ENVIRONMENT=development
PROJECT_NAME="DataPilot"
API_V1_STR="/api/v1"
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=True

# CORS Configuration (comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=datapilot
POSTGRES_PASSWORD=datapilot_secret_pass
POSTGRES_DB=datapilot_db
# Optional override URL (asyncpg format)
# DATABASE_URL=postgresql+asyncpg://datapilot:datapilot_secret_pass@localhost:5432/datapilot_db

# Redis Cache / Queue Foundation
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Optional override URL
# REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration (Phase 2 Requirement Understanding)
# High-speed AI inference via Groq API (Llama models: llama-3.3-70b-versatile, llama-3.1-8b-instant, etc.)
AI_PROVIDER=groq
AI_MODEL=llama-3.3-70b-versatile
AI_API_KEY=your_groq_api_key_here
GROQ_API_KEY=your_groq_api_key_here
AI_TIMEOUT_SECONDS=30

# Optional Alternative Provider (Google Gemini):
# AI_PROVIDER=gemini
# AI_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=your_gemini_api_key_here

# Source Collection Engine Configuration (Phase 4)
DATAPILOT_HTTP_TIMEOUT=20
DATAPILOT_HTTP_MAX_RETRIES=3
DATAPILOT_HTTP_USER_AGENT="DataPilot/0.1 (+https://github.com/RudraBhungaliya/DataPilot)"
DATAPILOT_REQUESTS_PER_DOMAIN=5
DATAPILOT_MIN_REQUEST_INTERVAL=0.5
DATAPILOT_MAX_DOCUMENT_SIZE_MB=10

# Optional Zyte Fallback Provider (Phase 4)
ZYTE_API_KEY=
ZYTE_API_URL=https://api.zyte.com/v1/extract

# Human-in-the-Loop Email Notification Configuration (Phase 4)
DATAPILOT_AUTH_EMAIL=client@datapilot.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@datapilot.local
SMTP_USE_TLS=True

# Frontend Settings (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="DataPilot"
