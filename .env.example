# ==============================================================================
# DataPilot - Environment Configuration
# ==============================================================================

# Backend Core Settings
ENVIRONMENT=development
PROJECT_NAME="DataPilot"
API_V1_STR="/api/v1"
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=True

# CORS Configuration (comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=datapilot
POSTGRES_PASSWORD=datapilot_secret_pass
POSTGRES_DB=datapilot_db
# Optional override URL (asyncpg format)
# DATABASE_URL=postgresql+asyncpg://datapilot:datapilot_secret_pass@localhost:5432/datapilot_db

# Redis Cache / Queue Foundation
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Optional override URL
# REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration (Phase 2)
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_API_KEY=your_gemini_api_key_here
AI_TIMEOUT_SECONDS=30

# Frontend Settings (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="DataPilot"
