# ==============================================================================
# DataPilot Server - Environment Configuration
# Location: apps/server/.env
# ==============================================================================

# Core Application Settings
PROJECT_NAME="DataPilot"
VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=True
API_V1_STR="/api/v1"
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS Configuration (Allowed origins for Next.js frontend)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=datapilot
POSTGRES_PASSWORD=datapilot_secret_pass
POSTGRES_DB=datapilot_db
# Optional full async connection string override (asyncpg)
# DATABASE_URL=postgresql+asyncpg://datapilot:datapilot_secret_pass@localhost:5432/datapilot_db

# Redis Cache & Queue Foundation
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Optional full Redis connection string override
# REDIS_URL=redis://localhost:6379/0

# AI / LLM Provider Configuration (Phase 2 Requirement Understanding)
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
AI_TIMEOUT_SECONDS=30

# Source Collection Engine Configuration (Phase 4)
DATAPILOT_HTTP_TIMEOUT=20
DATAPILOT_HTTP_MAX_RETRIES=3
DATAPILOT_HTTP_USER_AGENT="DataPilot/0.1 (+https://github.com/RudraBhungaliya/DataPilot)"
DATAPILOT_REQUESTS_PER_DOMAIN=5
DATAPILOT_MIN_REQUEST_INTERVAL=0.5
DATAPILOT_MAX_DOCUMENT_SIZE_MB=10

# Optional Zyte Fallback Provider (Phase 4)
ZYTE_API_KEY=
ZYTE_API_URL=https://api.zyte.com/v1/extract
