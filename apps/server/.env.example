# ==============================================================================
# DataPilot Server - Environment Configuration
# Location: apps/server/.env
# ==============================================================================

# Core Application Settings
PROJECT_NAME="DataPilot"
VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=True
API_V1_STR="/api/v1"
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS Configuration (Allowed origins for Next.js frontend)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=datapilot
POSTGRES_PASSWORD=datapilot_secret_pass
POSTGRES_DB=datapilot_db
# Optional full async connection string override (asyncpg)
# DATABASE_URL=postgresql+asyncpg://datapilot:datapilot_secret_pass@localhost:5432/datapilot_db

# Redis Cache & Queue Foundation
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Optional full Redis connection string override
# REDIS_URL=redis://localhost:6379/0

# AI / LLM Provider Configuration (Groq API & Llama Mode)
# High-speed AI inference via Groq API (Llama models: llama-3.3-70b-versatile, llama-3.1-8b-instant, etc.)
AI_PROVIDER=groq
AI_MODEL=llama-3.3-70b-versatile
AI_API_KEY=your_groq_api_key_here
GROQ_API_KEY=your_groq_api_key_here
AI_TIMEOUT_SECONDS=30

# Optional Alternative Provider (Google Gemini):
# AI_PROVIDER=gemini
# AI_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=your_gemini_api_key_here

# Source Collection Engine Configuration (Phase 4)
DATAPILOT_HTTP_TIMEOUT=20
DATAPILOT_HTTP_MAX_RETRIES=3
DATAPILOT_HTTP_USER_AGENT="DataPilot/0.1 (+https://github.com/RudraBhungaliya/DataPilot)"
DATAPILOT_REQUESTS_PER_DOMAIN=5
DATAPILOT_MIN_REQUEST_INTERVAL=0.5
DATAPILOT_MAX_DOCUMENT_SIZE_MB=10

# Optional Zyte Fallback Provider (Phase 4)
ZYTE_API_KEY= 
ZYTE_API_URL=https://api.zyte.com/v1/extract

# Human-in-the-Loop Email Notification Configuration (Phase 4)
DATAPILOT_AUTH_EMAIL=client@datapilot.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@datapilot.local
SMTP_USE_TLS=True

# Phase 7: Production / Security
# Enable API-key auth (recommended for production). Create the first key with
# BOOTSTRAP_API_KEY, then POST /api/v1/auth/keys.
AUTH_ENABLED=False
BOOTSTRAP_API_KEY=
# Per-client request limit (0 disables). Redis-backed when available.
RATE_LIMIT_PER_MINUTE=0
RATE_LIMIT_WINDOW_SECONDS=60
# Background worker: run in-process (True) or as a dedicated process (False)
RUN_EMBEDDED_WORKER=True
WORKER_CONCURRENCY=2
METRICS_ENABLED=True
# Enforce robots.txt for collection (recommended: True in production)
DATAPILOT_ROBOTS_ENFORCED=False

# Phase 4+: Dynamic source discovery (web search)
# SEARCH_PROVIDER: "" (disabled) | "brave" | "tavily" | "generic"
SEARCH_PROVIDER=
SEARCH_API_URL=
SEARCH_API_KEY=
SEARCH_RESULTS_PATH=web.results
SEARCH_URL_FIELD=url
SEARCH_TITLE_FIELD=title
SEARCH_MAX_RESULTS=8

# Phase 5+: Grounding / verification
GROUNDING_PROBE_ENABLED=False
GROUNDING_MIN_COVERAGE=0.5

